{
  "name": "clairvoyant-js",
  "version": "1.0.0",
  "description": "Predictive negative-latency Express middleware using Markov Chains and LRU Cache to pre-fetch API responses before the user clicks.",
  "author": "Krish Kothari",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch examples/benchmark.ts",
    "benchmark": "tsx examples/benchmark.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "express",
    "middleware",
    "predictive",
    "prefetch",
    "markov-chain",
    "lru-cache",
    "negative-latency",
    "performance",
    "optimization"
  ],
  "peerDependencies": {
    "express": ">=4.17.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "express": "^4.21.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
