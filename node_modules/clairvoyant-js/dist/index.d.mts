import { Request, Response, NextFunction } from 'express';

/**
 * MarkovGraph — The Predictive Brain
 *
 * Directed Weighted Graph built with nested Maps.
 * Each node is a normalized route (e.g. "GET:/api/dashboard").
 * Edges store transition counts to subsequent routes.
 *
 * Transition probability:
 *   P(Next | Current) = EdgeWeight(Current -> Next) / TotalOutgoingWeight(Current)
 */
interface Prediction {
    route: string;
    probability: number;
}
interface GraphSnapshot {
    nodes: string[];
    edges: Array<{
        from: string;
        to: string;
        weight: number;
        probability: number;
    }>;
    totalTransitions: number;
}

/**
 * LRUCache — O(1) Predictive RAM Store with TTL
 *
 * Custom implementation using a Doubly Linked List + Hash Map
 * for O(1) get, put, and delete operations.
 *
 * Supports:
 * - Configurable maxSize (default: 500)
 * - TTL-based expiry (default: 15000ms)
 * - Per-user invalidation on state-mutating requests
 */
interface CachedResponse {
    status: number;
    headers: Record<string, string>;
    body: unknown;
    /** Time in ms the original DB/handler execution took */
    executionTimeMs: number;
    /** Timestamp when cached */
    cachedAt: number;
}
interface LRUCacheOptions {
    maxSize?: number;
    ttlMs?: number;
}

/**
 * Logger — Stylized ANSI Telemetry
 *
 * Color-coded terminal logger using raw ANSI escape codes.
 * Zero dependencies — no chalk, no picocolors.
 */
interface LoggerOptions {
    /** Disable all logging output */
    silent?: boolean;
    /** Include timestamps in log output */
    timestamps?: boolean;
}

/**
 * Clairvoyant — Predictive "Negative Latency" Express Middleware
 *
 * Uses Markov Chains and an LRU Cache to predict and pre-fetch
 * a user's next API request before they click.
 *
 * Usage:
 *   import { Clairvoyant } from 'clairvoyant-js';
 *   app.use(Clairvoyant.observe());
 *
 * @module clairvoyant-js
 */

interface ClairvoyantOptions {
    /** Minimum prediction confidence to trigger a pre-fetch (0.0–1.0, default: 0.60) */
    confidenceThreshold?: number;
    /** Minimum outgoing samples before predictions are emitted (default: 3) */
    minSamples?: number;
    /** Maximum pre-fetched responses stored in the LRU cache (default: 500) */
    maxCacheSize?: number;
    /** Time-to-live in ms before an unconsumed prediction expires (default: 15000) */
    ttlMs?: number;
    /** Route prefixes excluded from graph tracking and pre-fetching (default: ['/health']) */
    ignorePaths?: string[];
    /** Enables color-coded ANSI telemetry logs in the terminal (default: true) */
    debug?: boolean;
    /**
     * Port the Express server is listening on (for loopback pre-fetch).
     * If omitted, auto-detected from the first incoming request.
     */
    port?: number;
}
interface ClairvoyantStats {
    cache: {
        size: number;
        maxSize: number;
        hits: number;
        misses: number;
        hitRate: number;
        totalMsSaved: number;
    };
    graph: GraphSnapshot;
}
declare const Clairvoyant: {
    /**
     * Create the Express middleware.
     * Initialize all internal systems on first call.
     */
    observe(options?: ClairvoyantOptions): (req: Request, res: Response, next: NextFunction) => void;
    /**
     * Get current cache and graph statistics.
     */
    getStats(): ClairvoyantStats;
    /**
     * Reset all internal state (for testing).
     */
    reset(): void;
};

export { type CachedResponse, Clairvoyant, type ClairvoyantOptions, type ClairvoyantStats, type GraphSnapshot, type LRUCacheOptions, type LoggerOptions, type Prediction };
